{
  "expo": {
    "name": "obihub",
    "slug": "frontend",
    "version": "1.1.04",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.obihub.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      },
      "runtimeVersion": "1.1.04"
    },
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.obihub.mobile",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/obihub/cha_ching.wav"
          ],
          "icon": "./assets/images/icon.png",
          "color": "#22C55E"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Ürün barkodlarını okutmak için kameraya erişim gerekir.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulama kilidini Face ID ile açmak için izin gerekir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90de2c08-4e66-4c91-a4f7-f5aa27669d82"
      }
    },
    "owner": "obihub-code",
    "updates": {
      "url": "https://u.expo.dev/90de2c08-4e66-4c91-a4f7-f5aa27669d82"
    }
  }
}
