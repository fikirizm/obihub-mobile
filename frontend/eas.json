{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_OBIHUB_API_URL": "https://api.obihub.app/api"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6767707711"
      }
    }
  }
}
